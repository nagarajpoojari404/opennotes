&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; &lt;span class="nf"&gt;println&lt;/span&gt;&lt;span class="p"&gt;(&lt;/span&gt;&lt;span class="s"&gt;&amp;#34;All concurrent workers completed successfully!&amp;#34;&lt;/span&gt;&lt;span class="p"&gt;);&lt;/span&gt;
