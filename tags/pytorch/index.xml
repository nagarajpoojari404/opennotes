&lt;h3 data-hextra-search-id="pre-training"&gt;Pre-Training&lt;span class="hx:absolute hx:-mt-20" id="pre-training"&gt;&lt;/span&gt;
&lt;a href="#pre-training" class="subheading-anchor" aria-label="Permalink for this section"&gt;&lt;/a&gt;&lt;/h3&gt;&lt;div class="hextra-code-block hx:relative hx:mt-6 hx:first:mt-0 hx:group/code"&gt;
